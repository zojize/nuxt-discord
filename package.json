{
  "name": "nuxt-discord",
  "type": "module",
  "version": "0.0.17",
  "packageManager": "bun@1.4.5",
  "description": "A Nuxt module for building Discord bots",
  "author": "Jize Zou <jeffzou2001@gmail.com> (https://github.com/zojize)",
  "license": "MIT",
  "repository": "git+https://github.com/zojize/nuxt-discord.git",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "discord",
    "discord-bot"
  ],
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./*": "./*"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "bun run dev:prepare && nuxi dev playground",
    "dev:debug": "bun run dev:prepare && node --inspect ./node_modules/nuxt/bin/nuxt.mjs dev playground --no-fork",
    "dev:build": "nuxi build playground",
    "dev:docs": "nuxi dev docs --port 4000",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "bun run release:check && changelogen --release && bun publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p docs/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p docs/.nuxt/tsconfig.node.json",
    "prepare": "simple-git-hooks",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "bun run dev:prepare && nuxi prepare docs && bun run lint && bun run test:types && bun run test && bun run test:package && NUXT_APP_BASE_URL=/nuxt-discord/ bun run --cwd docs generate"
  },
  "peerDependencies": {
    "discord.js": "^14.28.1"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/vue": "^5.0.5",
    "@nuxt/kit": "^4.6.4",
    "@nuxt/ui": "^4.13.0",
    "@vueuse/core": "^15.0.0",
    "ansis": "^4.5.0",
    "chokidar": "^6.0.0",
    "defu": "^6.1.7",
    "knitwork": "^1.3.0",
    "listhen": "^1.10.1",
    "rollup": "^4.68.7",
    "simple-icons": "^16.38.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "changelogen": "^0.6.2",
    "eslint": "^10.15.0",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.1",
    "nuxt": "^4.6.4",
    "simple-git-hooks": "^2.14.0",
    "unbuild": "^3.6.1",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "workspaces": [
    "playground",
    "docs"
  ],
  "resolutions": {
    "nuxt-discord": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "bun install --frozen-lockfile && bunx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
